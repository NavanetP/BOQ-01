# ── Vercel / Production ──────────────────────────────────────
# These are the only variables needed for Vercel deployment.
# Add them in: Vercel Dashboard → Project → Settings → Environment Variables

# Groq API key — get one free at https://console.groq.com
# IMPORTANT: restrict this key to your Vercel domain in the Groq dashboard
VITE_GROQ_API_KEY=your-groq-api-key-here

# Optional: override the default model
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Google OAuth client ID (for login)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here


# ── Local development only (not needed on Vercel) ────────────
# Used by server.js when running `npm run server` locally.
# Enables the "Refresh Prices" and "Update All Products" buttons
# which write updated data back to the JSON files on disk.

GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
PORT=3002
